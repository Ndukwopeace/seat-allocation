# Copy this to .env (scripts/env-setup.sh does this for you) and adjust as
# needed. .env is gitignored — never commit real secrets.

DATABASE_URL="postgresql://siu_app:siu_app_dev@localhost:5432/siu_seat_allocation?schema=public"

# Secret used to sign session JWTs (lib/auth.ts). scripts/env-setup.sh
# generates a random one for you; replace with a strong value in production.
SESSION_SECRET="replace-with-a-long-random-value"

# Google OAuth client (lib/google-oauth.ts) — powers the "Continue with
# Google" login option. Create one at https://console.cloud.google.com/
# under "APIs & Services" -> "Credentials" -> "Create Credentials" ->
# "OAuth client ID" -> Application type "Web application". Add an
# Authorized redirect URI of `<your-app-origin>/login/google/callback`
# (e.g. http://localhost:3000/login/google/callback for local dev).
# "Continue with Google" is safe to leave unconfigured — password login
# still works without these set, only the Google button will error.
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
